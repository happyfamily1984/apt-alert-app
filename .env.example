# 공공데이터포털(data.go.kr) 인증키 — 비우면 데모 데이터로 동작
#  · "국토교통부_아파트 매매 실거래가 자료" 와 "국토교통부_아파트 전월세 실거래가 자료" 두 API 모두 활용신청 필요
#  · 일반 인증키(Encoding/Decoding) 아무거나 넣어도 됩니다
MOLIT_SERVICE_KEY=

PORT=3000
# 새 실거래 확인 주기(분). 국토부 데이터는 하루 단위로 갱신됩니다.
POLL_INTERVAL_MINUTES=180
# 단지 목록/거래 내역에 사용하는 최근 개월 수
COMPLEX_MONTHS=6
# DATA_FILE=./data/db.json

# Web Push VAPID 키 (비우면 최초 실행 시 자동 생성되어 DB에 저장)
# 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 설정하면 POST /api/admin/poll 호출 시 X-Admin-Token 헤더 필요
ADMIN_TOKEN=
